{
  "cleanUrls": true,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/grants",
      "destination": "/support",
      "permanent": false
    },
    {
      "source": "/grants.html",
      "destination": "/support",
      "permanent": false
    },
    {
      "source": "/training-preparedness",
      "destination": "/training",
      "permanent": false
    },
    {
      "source": "/training-preparedness.html",
      "destination": "/training",
      "permanent": false
    },
    {
      "source": "/technology-intelligence",
      "destination": "/technology",
      "permanent": false
    },
    {
      "source": "/technology-intelligence.html",
      "destination": "/technology",
      "permanent": false
    },
    {
      "source": "/partners",
      "destination": "/community-network",
      "permanent": false
    },
    {
      "source": "/partners.html",
      "destination": "/community-network",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(account|trainings|admin)(.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
